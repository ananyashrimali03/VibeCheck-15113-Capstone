# Copy this file to .env.local and fill in your keys.

# Gemini API key — required for live mood inference
# Get one free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: YouTube Data API v3 — used first to resolve official videos (then Piped fallback).
YOUTUBE_API_KEY=

# Optional: comma-separated Piped API base URLs for search + audio streams when resolving full tracks.
# Default list is built-in; override if public instances are slow or blocked in your region.
# PIPED_API_BASES=https://pipedapi.kavin.rocks,https://pipedapi.in.projectsegfau.lt

# Music: iTunes Search API — no key needed (free, built-in)
